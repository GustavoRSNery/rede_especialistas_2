# =========================================================
# Frontend BFF — Variáveis de ambiente (Node.js runtime)
# =========================================================

# URLs para chamadas server-to-server (BFF → Backend via nginx)
BACKEND_API_URL=http://nginx/backend/api
BACKEND_WEBHOOK_URL=http://nginx/backend/webhook

# Porta do servidor Express
PORT=3000

# Redis para a fila de comandos e cache
REDIS_URL=redis://redis:6379
