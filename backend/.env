# =========================================================
# Backend — Variáveis de ambiente
# NUNCA commitar este arquivo com valores reais em produção.
# =========================================================

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=taskmanager
DB_USER=taskuser
DB_PASSWORD=changeme_in_production

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Nonce / Idempotency TTL em segundos
NONCE_TTL_SECONDS=300

# URL do webhook do frontend (via nginx na private_net)
FRONTEND_WEBHOOK_URL=http://nginx/frontend/webhook/notifications
FRONTEND_API_URL=http://nginx/frontend/api/sync-cache
